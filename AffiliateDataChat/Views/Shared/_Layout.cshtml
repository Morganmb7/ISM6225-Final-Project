<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Affiliate Data Chat</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index">Affiliate Data Chat</a>
        <nav aria-label="Main navigation">
            <a asp-controller="Home" asp-action="Index">Architecture</a>
            <a asp-controller="Chat" asp-action="Index">Chat</a>
        </nav>
    </header>
    <main class="page-shell">
        @RenderBody()
    </main>
    <footer>Graduate AI &amp; Business Analytics · C# MVC + MCP + SQLite</footer>
</body>
</html>